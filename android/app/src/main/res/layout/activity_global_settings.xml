<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_global_settings"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Global Settings"
            app:titleTextColor="?attr/colorOnSurface"
            app:navigationIcon="@drawable/ic_arrow_back_modern"
            app:navigationIconTint="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Engine Mode"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <RadioGroup
                android:id="@+id/rg_engine_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rb_engine_singbox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sing-Box"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary" />

                <RadioButton
                    android:id="@+id/rb_engine_xray"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xray"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VPN Mode"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <RadioGroup
                android:id="@+id/rg_tunnel_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rb_mode_vpn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VPN"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary" />

                <RadioButton
                    android:id="@+id/rb_mode_proxy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Proxy"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reality Settings"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_use_fragmentation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use Fragmentation"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_block_quic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Block QUIC"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="0dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Block UDP:443 to stream youtube etc."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Layer 7 Ping (TLS Handshake)"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_use_layer7_ping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use Layer 7 Ping"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="24dp" />

            <View
                android:id="@+id/div_protocol_mode_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tv_global_protocol_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Global Protocol Override"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_global_protocol_override"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Override Per-Config Protocol"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <Spinner
                android:id="@+id/spinner_global_protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:backgroundTint="?attr/colorOnSurface"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tv_global_cdn_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CDN Management"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:id="@+id/layout_cdn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_cdn_label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="CDN"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/spinner_cdn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CDN IP Management"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/btn_cf_history"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="?attr/colorPrimary" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Global DNS Server"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"/>

                <EditText
                    android:id="@+id/et_global_dns_server"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:hint="Set via Scanner"
                    android:inputType="none"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:cursorVisible="false"
                    android:longClickable="true"
                    android:maxLines="1"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>
            
            <TextView
                android:id="@+id/tv_tunnel_apps_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tunnel Applications"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <RadioGroup
                android:id="@+id/rg_tunnel_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/rb_apps_all"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="All Apps"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary" />

                <RadioButton
                    android:id="@+id/rb_apps_selected"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Selected Apps"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary"
                    android:checked="true" />
            </RadioGroup>

            <TextView
                android:id="@+id/tv_all_apps_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not applicable to vaydns protocol."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_tunnel_android_services"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tunnel Android Services"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <View
                android:id="@+id/div_startup_mode_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tv_startup_behavior_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Startup Behavior"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_default_configs_at_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Default Configs at Start"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification Management"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Unlocked State Delay (ms)"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"/>
                <EditText
                    android:id="@+id/et_unlocked_delay"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="5"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Locked State Delay (ms)"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"/>
                <EditText
                    android:id="@+id/et_locked_delay"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="5"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Notification Update (ms)"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"/>
                <EditText
                    android:id="@+id/et_notif_update"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="5"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VayDNS Settings"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Tunnel MTU (0 = Default, 30-130)"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"/>

                <EditText
                    android:id="@+id/et_vaydns_mtu"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log Settings"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable Debug Logs"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Write logs to a file for troubleshooting."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/cb_debug_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="?attr/colorPrimary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show Share Logs Menu"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display 'Share Log' option in the main menu."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/cb_show_share_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="?attr/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show Debug Logging Menu"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display 'Start/Stop Debug Log' option in the main menu."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/cb_show_debug_logging"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="?attr/colorPrimary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu Visibility"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_show_update_configs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update Configs"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_show_update_resolvers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update Resolvers"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_show_upload_configs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload Configs"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_show_upload_resolvers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload Resolvers"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="24dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_show_import_resolvers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Import Resolvers"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_show_export_resolvers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export Resolvers"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="24dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_show_import_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Import App List"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_show_export_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export App List"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/cb_show_backup_restore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Backup &amp; Restore"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>