<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_vless"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Add VLESS Config"
            app:titleTextColor="?attr/colorOnSurface"
            app:navigationIcon="@drawable/ic_arrow_back_modern"
            app:navigationIconTint="?attr/colorOnSurface">

            <ImageButton
                android:id="@+id/btn_save_vless"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_check_modern"
                app:tint="?attr/colorOnSurface" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- CORE CONFIGURATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Core Configuration"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Config Name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/et_vless_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="My VLESS Server"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server IP"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/et_vless_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="192.168.1.1 or example.com"
                android:inputType="textUri"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <!-- NEW CLOUDFLARE RACE BLOCK -->
            <LinearLayout
                android:id="@+id/layout_cf_race"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_fetched_cf_ip"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Tap sync to find best Cloudflare IP"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="16sp"
                        android:textIsSelectable="true"
                        android:padding="12dp"
                        android:background="?attr/editTextBackground" />

                    <ImageButton
                        android:id="@+id/btn_get_cf_ip"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:src="@android:drawable/ic_popup_sync"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="Get Cloudflare IP"
                        android:tooltipText="Get Cloudflare IP" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use this IP if your server is behind Cloudflare. You can tap to copy and paste it into the Server IP field above."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Port"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/et_vless_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="443"
                android:inputType="number"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UUID (id)"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/et_vless_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:gravity="top|start"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Flow"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />
                <Spinner
                    android:id="@+id/sp_vless_flow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Encryption"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />
                <EditText
                    android:id="@+id/et_vless_encryption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="100dp"
                    android:text="none"
                    android:inputType="text"
                    android:textColor="?attr/colorOnSurface"
                    android:backgroundTint="?attr/colorOnSurface" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <!-- TRANSPORT SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transport Section"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Network"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />
                <Spinner
                    android:id="@+id/sp_vless_network"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorOnSurface" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_vless_host_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="websocket host"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/et_vless_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="example.com"
                android:inputType="textUri"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_vless_path_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="websocket path"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/et_vless_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="/path"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Transport Layer Encryption"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />
                <Spinner
                    android:id="@+id/sp_vless_tls_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorOnSurface" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <!-- TLS SETTINGS CONTAINER -->
            <LinearLayout
                android:id="@+id/layout_tls_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TLS Settings"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Fingerprint"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />
                    <Spinner
                        android:id="@+id/sp_tls_fingerprint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="ALPN"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />
                    <Spinner
                        android:id="@+id/sp_tls_alpn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Allow Insecure"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />
                    <Spinner
                        android:id="@+id/sp_tls_allow_insecure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="?attr/colorOnSurface" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Certificate fingerprint (SHA-256)"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />
                <EditText
                    android:id="@+id/et_tls_sha256"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Optional"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:gravity="top|start"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="24dp" />
            </LinearLayout>

            <!-- REALITY SETTINGS CONTAINER -->
            <LinearLayout
                android:id="@+id/layout_reality_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reality Settings"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Fingerprint"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />
                    <Spinner
                        android:id="@+id/sp_reality_fingerprint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="?attr/colorOnSurface" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SNI"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />
                <EditText
                    android:id="@+id/et_reality_sni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PublicKey"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />
                <EditText
                    android:id="@+id/et_reality_pubkey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:gravity="top|start"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shortid"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />
                <EditText
                    android:id="@+id/et_reality_shortid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="24dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>