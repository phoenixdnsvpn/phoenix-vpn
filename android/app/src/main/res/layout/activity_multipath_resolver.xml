<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:fitsSystemWindows="true">

    <!-- TOP TOOLBAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_resolvers"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Multipath Resolvers"
            app:titleTextColor="?attr/colorOnSurface"
            app:navigationIcon="@drawable/ic_arrow_back_modern"
            app:navigationIconTint="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- RecyclerView List Filling the Center Space -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_resolvers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:clipToPadding="false" />

        <!-- SLIM BOTTOM ACTION BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="?attr/colorSurface"
            app:elevation="8dp">

            <!-- Import Icon -->
            <ImageButton
                android:id="@+id/btn_import_resolvers"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_input_modern"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Import Resolvers" />

            <!-- Check/Toggle All Icon -->
            <ImageButton
                android:id="@+id/btn_toggle_all_resolvers"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_check_modern"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Toggle All" />

            <!-- Delete Icon -->
            <ImageButton
                android:id="@+id/btn_delete_resolvers"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_delete_modern"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Delete" />

            <!-- Export Icon -->
            <ImageButton
                android:id="@+id/btn_export_resolvers"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_share_modern"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Export" />

            <!-- Save Icon -->
            <ImageButton
                android:id="@+id/btn_save_resolvers"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_save_modern"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Save" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>