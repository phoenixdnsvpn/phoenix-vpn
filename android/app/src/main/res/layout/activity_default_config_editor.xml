<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_editor"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Edit Default Parameters"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIcon="@drawable/ic_arrow_back_modern"
        app:navigationIconTint="?attr/colorOnSurface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="4dp">

            <ImageButton
                android:id="@+id/btn_save_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_check_modern"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Save Config" />
        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Config Name:"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_config_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:id="@+id/layout_tunnel_protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_tunnel_protocol_label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Protocol Mode:"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_tunnel_protocol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- CDN Cloud Selector -->
            <LinearLayout
                android:id="@+id/layout_editor_cdn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Target CDN Cloud:"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_editor_cdn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- VLESS Protocol Selector -->
            <LinearLayout
                android:id="@+id/layout_vless_protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Vless-Protocol:"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_vless_protocol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_editor_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Target Port:"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_editor_port"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="?attr/colorOnSurface" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_vless_ip_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cloud IP (VLESS):"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="16dp"
                android:textStyle="bold"
                android:visibility="gone" />

            <EditText
                android:id="@+id/et_vless_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Leave empty to use the internal IP"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textColor="?attr/colorOnSurface"
                android:inputType="text"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_best_cf_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Get best IP from Vault"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_domain_selector_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Active Domain:"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="16dp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_domain_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <RadioButton android:id="@+id/rb_domain_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:buttonTint="?attr/colorPrimary" android:text="Domain 1" />
                <RadioButton android:id="@+id/rb_domain_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:buttonTint="?attr/colorPrimary" android:text="Domain 2" />
                <RadioButton android:id="@+id/rb_domain_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:buttonTint="?attr/colorPrimary" android:text="Domain 3" />
                <RadioButton android:id="@+id/rb_domain_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:buttonTint="?attr/colorPrimary" android:text="Domain 4" />
            </RadioGroup>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_multi_domain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Use Multi Domains"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:checked="false" />

            <!-- Slipstream Params for Defaults -->
            <LinearLayout
                android:id="@+id/layout_slipstream_params"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Congestion Control:"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="16dp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/sp_slipstream_congestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    style="@style/Widget.AppCompat.Spinner.Underlined"
                    android:backgroundTint="?attr/colorOnSurface" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_slipstream_gso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="GSO (Generic Segmentation Offload)"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    app:thumbTint="?attr/colorPrimary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_record_type_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Record Type:"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="16dp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/sp_record_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/Widget.AppCompat.Spinner.Underlined"
                android:backgroundTint="?attr/colorOnSurface"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_dns_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DNS Server:"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="16dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_use_default_resolvers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Use default resolvers"
                android:textColor="?attr/colorOnSurface"
                android:checked="false"
                android:textSize="14sp"
                app:thumbTint="?attr/colorPrimary" />

            <EditText
                android:id="@+id/et_dns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:text="8.8.8.8:53"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_multipath_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multipath Resolvers:"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="16dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_multipath_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selective Multipath will race Up to 3 IPs for faster connection."
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/layout_multipath_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tv_multipath_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 IPs selected"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/btn_select_multipath"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="Select Multipath Resolvers" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_mode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tunnel Mode:"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="16dp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_udp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UDP"
                    android:checked="true"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary" />

                <RadioButton
                    android:id="@+id/rb_tcp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TCP"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary" />

                <RadioButton
                    android:id="@+id/rb_tls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DoT"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary" />

                <RadioButton
                    android:id="@+id/rb_https"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DoH"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary" />

                <RadioButton
                    android:id="@+id/rb_auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTO"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary"
                    android:visibility="gone" />
            </RadioGroup>

            <!-- MTU -->
            <TextView
                android:id="@+id/tv_mtu_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Min. Upload MTU:"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="16dp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_mtu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="40"
                android:textColorHint="@android:color/darker_gray"
                android:textColor="?attr/colorOnSurface"
                android:inputType="number"
                android:text="40" />

            <LinearLayout
                android:id="@+id/layout_extended_mtu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max. Upload MTU:"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="12dp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_max_mtu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="140"
                    android:textColor="?attr/colorOnSurface"
                    android:inputType="number"
                    android:text="140" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resolver MTU Parallelism:"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="12dp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_parallelism"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="32"
                    android:textColor="?attr/colorOnSurface"
                    android:inputType="number"
                    android:text="32" />
            </LinearLayout>

            <!-- Compression (Extended DNS) -->
            <LinearLayout
                android:id="@+id/layout_compression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Compression:"
                        android:textSize="12sp"
                        android:textColor="#808080"/>
                    <Spinner
                        android:id="@+id/sp_upload_compression"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Download Compression:"
                        android:textSize="12sp"
                        android:textColor="#808080"/>
                    <Spinner
                        android:id="@+id/sp_download_compression"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Local Proxy Protocol -->
            <TextView
                android:id="@+id/tv_proxy_protocol_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Local Proxy Protocol:"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_proxy_protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rb_proxy_socks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOCKS5"
                    android:checked="true"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary" />

                <RadioButton
                    android:id="@+id/rb_proxy_http"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HTTP"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:buttonTint="?attr/colorPrimary" />
            </RadioGroup>

        </LinearLayout>
    </ScrollView>
</LinearLayout>