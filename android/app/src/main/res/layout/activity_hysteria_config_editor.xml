<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_hysteria"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Add Hysteria Config"
            app:titleTextColor="?attr/colorOnSurface"
            app:navigationIcon="@drawable/ic_arrow_back_modern"
            app:navigationIconTint="?attr/colorOnSurface">

            <ImageButton
                android:id="@+id/btn_save_hysteria"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_check_modern"
                app:tint="?attr/colorOnSurface" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- CONFIG & SERVER SETTINGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Configuration"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Config Name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/et_hys_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="My Hysteria Server"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server IP"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/et_hys_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="127.0.0.1 or example.com"
                android:inputType="textUri"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="24dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_hys_port_hopping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use Port Hopping"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:checked="false"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/layout_hys_port_hopping_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Port Hopping Interval (seconds)"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use 0 to ignore changing the port frequently"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="16dp"/>

                <EditText
                    android:id="@+id/et_hys_port_hopping_interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="10"
                    android:inputType="number"
                    android:text="10"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Port(s)"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/et_hys_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="443"
                android:inputType="text"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maximum Upload (Mbps)"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/et_hys_up_mbps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="100"
                android:inputType="number"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maximum Download (Mbps)"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/et_hys_down_mbps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="500"
                android:inputType="number"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="24dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <!-- AUTHENTICATION SETTINGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Authentication"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Authentication Password"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle"
                app:endIconTint="?attr/colorOnSurface"
                app:hintEnabled="false"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/et_hys_auth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@android:color/transparent"
                    android:paddingBottom="8dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Obfuscation Password"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle"
                app:endIconTint="?attr/colorOnSurface"
                app:hintEnabled="false"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/et_hys_obfs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Optional"
                    android:inputType="textPassword"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@android:color/transparent"
                    android:paddingBottom="8dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/dividerVertical"
                android:layout_marginBottom="24dp"/>

            <!-- TLS & SECURITY SETTINGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TLS &amp; Verification"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SNI (Server Name Indication)"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />
            <EditText
                android:id="@+id/et_hys_sni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="example.com"
                android:inputType="textUri"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_hys_insecure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Allow Insecure (Skip Cert Verify)"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                app:thumbTint="?attr/colorPrimary"
                android:checked="true"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/layout_hys_sha256"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHA-256 Certificate Pin"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />
                <EditText
                    android:id="@+id/et_hys_sha256"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter SHA-256 hash"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:gravity="top|start"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>