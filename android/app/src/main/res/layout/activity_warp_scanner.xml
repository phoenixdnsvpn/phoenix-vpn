<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_warp_scanner"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="WARP Scanner"
            app:titleTextColor="?attr/colorOnSurface"
            app:navigationIcon="@drawable/ic_arrow_back_modern"
            app:navigationIconTint="?attr/colorOnSurface">

            <ImageButton
                android:id="@+id/btn_warp_set"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_check_modern"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Set Fastest IP" />

            <ImageButton
                android:id="@+id/btn_warp_share"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_share_modern"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Share IPs" />

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <!-- Scanner Protocol Selector -->
        <RadioGroup
            android:id="@+id/rg_scanner_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_use_warp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WIREGUARD"
                android:checked="true"
                android:textSize="14sp"
                android:layout_marginEnd="16dp"
                app:buttonTint="?attr/colorPrimary" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_use_masque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MASQUE"
                android:textSize="14sp"
                app:buttonTint="?attr/colorPrimary" />
        </RadioGroup>

        <!-- Inputs Row 1: Scan Count, Target Port, Workers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:hint="Count">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_warp_scan_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="256" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:hint="Port">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_warp_target_port"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="2408" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:hint="Workers">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_warp_workers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="10" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Inputs Row 2: Timeouts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:hint="Handshake (ms)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_warp_handshake_timeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="800" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:hint="Max Idle (ms)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_warp_max_timeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="1500" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Ports Configuration Section -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cb_warp_all_ports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use all Ports"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_warp_ports_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available WIREGUARD: 2408, 500, 4500, 1701"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="8dp" />

        <!-- Progress and Control Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_warp_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 256"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_warp_passed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0 found"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#00C853" />

            <Button
                android:id="@+id/btn_warp_start_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="START SCAN"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_warp_results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp" />

    </LinearLayout>
</LinearLayout>